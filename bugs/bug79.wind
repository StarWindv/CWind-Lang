pub trait MyClone  {
    fn mclone(&self) -> Self;
}

impl<T: Clone> MyClone for Vec<T> {
    fn mclone(&self) -> Self<T> {
        let mut result: Self<T> = Self::new();
        for ele in self { // 这里消耗了所有权
            result.push_back(ele.clone());
        }
        result
    }
}
