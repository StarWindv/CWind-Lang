fn main() {
    // does raw u32 arithmetic wrap?
    let a: u32 = 0xFFFFFFFF;
    print(a + 1);        // 0
    print(a * 2);        // 4294967294
    print(0 as u32 - 1); // 4294967295
    let b: u32 = 1;
    print(b - 2);        // 4294967295
    // signed wrap
    let c: i8 = 127;
    print(c + 1);        // -128
    let d: i8 = -128;
    print(d - 1);        // 127
    print(d * -1);       // -128 (signed overflow wraps)
    // shifts with variable amount
    let amt: u32 = 40;
    print((1 as u32) << amt);       // 256 if masked? raw shl by 40 is UB!
}
