//  - [ ] 15. 函数传参时未移动所有权 (赦免 self, 其在现阶段需要传递引用)

// From 自动派生 Into 后, `array.into()` 会走 `Set::from(array)`,
// 此时 array 作为非 self 形参被移动, 后续 print(array) 应报 use-after-move
impl<T> From<Vector<T>> for Set<T> {
    fn from(array: Vector<T>) -> Self<T> {
        let result: Set<T> = Set::new();
        for ele in array {
            result.add(ele);
        }
        return result;
    }
}

fn main() {
    let array: Vector<Int> = [1, 1, 2, 3, 4, 1];
    let set  : Set<Int>    = array.into();
    print(array); // 证明所有权仍未转移
    print(set);
}
