//
// use std::iterator;
//
// typedef hashfn<K> = fn(&K) -> uint;
// typedef eqfn<K> = fn(&K, &K) -> bool;
//
// pub enum Bucket<K, V> {
//     Empty,
//     Deleted,
//     Some(K, V)
// }
//
// struct Rational {
//     num: i32,
//     den: i32,
// }
//
// pub struct HashMap<K, V> {
//     hasher: fn(&K) -> usize,
//     eqer: fn(&K, &K) -> bool,
//     buckets: Vector<Bucket<K, V>>,
//     nbkts: usize,
//     nelts: usize,
//     load_factor: Rational,
// }
//
// impl<K, V> iterator::Iterator for HashMap<K, V> {
//     fn next(&self)
