// todo-179: quote! 生成代码的裸名入口 (表达式位三段路径不可用,
// 生成代码只能发 1 段名; 见 std::proc_macro 的说明)。
pub use crate::proc_macro::quote_concat;
pub use crate::proc_macro::quote_of;
pub use crate::proc_macro::quote_tok;


extra Bool {
    pub fn toggle(&mut self) {
        *self = !*self;
    }
}
