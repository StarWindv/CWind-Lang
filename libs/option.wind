use std::common;

enum Option<T> {
    None,
    Some(T)
}


fn unwrap_failed() -> ! {
    common::panic("Called `Option::unwrap()` on a `None` value");
}

extra<T> Option<T> {
    pub fn unwrap(self) -> T {
        return match (self) {
            Option::Some(val) => val,
            _ => unwrap_failed(),
        };
    }
}
