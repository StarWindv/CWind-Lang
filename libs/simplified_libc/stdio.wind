use std::ctypedef::*;

pub extern "C" {
    pub fn fopen(path: String, mode: String) -> c_longlong;
    pub fn fclose(f: c_longlong) -> c_int;
    pub fn fputs(s: String, f: c_longlong) -> c_int;
    pub fn fprintf(f: c_longlong, s: String) -> c_int;
    pub fn fflush(f: c_longlong) -> c_int;
    pub fn fgetc(f: c_longlong) -> c_int;
    pub fn feof(f: c_longlong) -> c_int;
    pub fn fseek(f: c_longlong, offset: c_longlong, origin: c_int) -> c_int;
    pub fn ftell(f: c_longlong) -> c_longlong;
    #[link_name = "fgets"]
    pub fn fgets_raw(buf: *mut Byte, cap: c_int, f: c_longlong) -> c_longlong;
}
