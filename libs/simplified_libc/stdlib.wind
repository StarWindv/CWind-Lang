pub extern "C" {
    fn malloc(size: u64) -> *mut Byte;
    fn free(ptr: *mut Byte);
    fn realloc(ptr: *mut Byte, new_size: u64) -> *mut Byte;
    fn calloc(count: u64, size: u64) -> *mut Byte;
    fn aligned_alloc(alignment: u64, size: u64) -> *mut Byte;
    fn memcpy(dest: *mut Byte, src: *const Byte, n: u64) -> *mut Byte;
    fn memset(s: *mut Byte, c: i32, n: u64) -> *mut Byte;
    fn strlen(s: *const Byte) -> u64;

    #[link_name="srand"]
    fn random_seed(seed: u32);

    #[link_name="rand"]
    fn randint() -> i32;

    #[link_name="atexit"]
    fn at_exit(func: fn()) -> i32;

    #[link_name="exit"]
    fn c_exit(status: i32); // -> !;

    // auto mapping to `char *`/`const char*`/`char []`
    fn system(cmd: &String) -> i32;

    #[link_name="abs"]
    fn i32_abs(x: i32) -> i32;

    #[link_name="labs"]
    fn i64_abs(x: i64) -> i64;

    #[link_name="getenv"]
    fn get_env(key: &String) -> Option<String>;
}
