// std::simplified_libc::time —— time.h 绑定 (todo-111)。
//
// 依赖 std::ctypedef 的平台相关别名 (time_t/clock_t/c_int/...),
// 使用方需 `use std::ctypedef::*;` 才能在自己的签名位书写这些名字;
// 仅调用本模块函数时无需导入别名 (SA 展开后为内置类型)。

use std::ctypedef::*;

/// struct tm
pub struct Tm {
    pub tm_sec: c_int,
    pub tm_min: c_int,
    pub tm_hour: c_int,
    pub tm_mday: c_int,
    pub tm_mon: c_int,
    pub tm_year: c_int,
    pub tm_wday: c_int,
    pub tm_yday: c_int,
    pub tm_isdst: c_int,
}

pub struct Timespec {
    pub tv_sec: time_t,
    pub tv_nsec: c_long,
}

pub extern "C" {
    /// 自进程启动起的处理器时间.
    pub fn clock() -> clock_t;

    /// 秒级的日历时间; t 非 NULL 时同时写入 *t.
    /// CWind 侧传借用变量, 例如 `let now: time_t = time(&t0);`
    pub fn time(t: *mut time_t) -> time_t;

    /// UTC 时间下的分解时间 (返回指向静态缓冲的指针, 非线程安全).
    pub fn gmtime(timer: *const time_t) -> *mut Tm;

    /// 本地时区下的分解时间 (返回指向静态缓冲的指针, 非线程安全).
    pub fn localtime(timer: *const time_t) -> *mut Tm;

    /// 分解时间 -> 日历时间; 归一化字段会写回 *tm (出参模式).
    pub fn mktime(tm: *mut Tm) -> time_t;

    /// t1 - t2 (秒).
    pub fn difftime(t1: time_t, t2: time_t) -> c_double;

    /// 可移植的时间获取 (TIME_UTC=1).
    pub fn timespec_get(ts: *mut Timespec, base: c_int) -> c_int;
}

/// TIME_UTC 的值 (<time.h>).
pub const TIME_UTC: c_int = 1;
