// std::proc_macro — 过程宏作者可见的 token 与诊断 API (todo-179).
//
// 宏体在独立进程里运行: 从 stdin 读入调用点 token, 写回输出 token
// (行协议见 .handover/analysis/CWind/ProcMacro/01_protocol.md)。
// 本模块把这些动作包装成 Token / TokenStream / Diagnostic,
// 并提供 quote! 生成代码所需的自由函数 (module::fn 形式,
// 避免 codegen 依赖关联函数路径)。
//
// 注意: 本文件自身的 #[proc_macro] 宏在 macros.wind 里 (见 pub mod macros;)。

use crate::builtins::print;
use crate::builtins::readline;
use crate::traits::cmp::Eq;

/// 一个词法 token (扁平流; 分组开/闭也是 token)。
pub struct Span {
    pub line: Int64,
    pub column: Int64,
    pub end_line: Int64,
    pub end_column: Int64,
}

struct ProcMacroCallSiteState {
    static line: Int64 = 0,
    static column: Int64 = 0,
    static end_line: Int64 = 0,
    static end_column: Int64 = 0,
}

extra Span {
    pub fn call_site() -> Span {
        return Span {
            ProcMacroCallSiteState::line,
            ProcMacroCallSiteState::column,
            ProcMacroCallSiteState::end_line,
            ProcMacroCallSiteState::end_column
        };
    }
}

pub struct Token {
    pub kind: String,
    pub text: String,
    pub span: Span,
}

/// 一段 token 流。
pub struct TokenStream {
    pub tokens: Vector<Token>,
}

/// nightly `proc_macro::Diagnostic` 对应物。
pub struct Diagnostic {
    pub level: String,
    pub message: String,
    pub span: Span,
}

// -- token 构造 -----------------------------------------------------------

pub fn token_ident(text: String) -> Token {
    return token_ident_at(Span::call_site(), text);
}

pub fn token_ident_at(span: Span, text: String) -> Token {
    return Token { "ident", text, span };
}

pub fn token_punct(text: String) -> Token {
    return token_punct_at(Span::call_site(), text);
}

pub fn token_punct_at(span: Span, text: String) -> Token {
    return Token { "punct", text, span };
}

pub fn token_literal(text: String) -> Token {
    return token_literal_at(Span::call_site(), text);
}

pub fn token_literal_at(span: Span, text: String) -> Token {
    return Token { "literal", text, span };
}

pub fn token_group_open(text: String) -> Token {
    return token_group_open_at(Span::call_site(), text);
}

pub fn token_group_open_at(span: Span, text: String) -> Token {
    return Token { "group_open", text, span };
}

pub fn token_group_close(text: String) -> Token {
    return token_group_close_at(Span::call_site(), text);
}

pub fn token_group_close_at(span: Span, text: String) -> Token {
    return Token { "group_close", text, span };
}

// -- 流构造 / 变换 --------------------------------------------------------

pub fn stream_new() -> TokenStream {
    let tokens: Vector<Token> = [];
    return TokenStream { tokens };
}

pub fn stream_of(tokens: Vector<Token>) -> TokenStream {
    return TokenStream { tokens };
}

pub fn stream_of_token(token: Token) -> TokenStream {
    let mut tokens: Vector<Token> = [];
    tokens.push_back(token);
    return TokenStream { tokens };
}

pub fn stream_concat(parts: Vector<TokenStream>) -> TokenStream {
    let mut tokens: Vector<Token> = [];
    let mut i: usize = 0;
    while (i < parts.length()) {
        let part: TokenStream = parts.get(i as isize);
        let mut j: usize = 0;
        while (j < part.tokens.length()) {
            tokens.push_back(part.tokens.get(j as isize));
            j = j + 1;
        }
        i = i + 1;
    }
    return TokenStream { tokens };
}

// -- 协议 IO --------------------------------------------------------------

fn protocol_fields(text: String) -> Vector<String> {
    let mut fields: Vector<String> = [];
    let mut field: String = "";
    for b in text {
        if ((b as Int32) == 9) {
            fields.push_back(field);
            field = "";
        } else {
            field = field + String::from_byte(b);
        }
    }
    fields.push_back(field);
    return fields;
}

fn protocol_coord(text: String) -> Int64 {
    if (text.length() == 0 || text.length() > 19) { return 0; }
    let mut value: Int64 = 0;
    for b in text {
        if ((b as Int32) < 48 || (b as Int32) > 57) { return 0; }
        let digit: Int64 = (b as Int64) - 48;
        if (value > 922337203685477580
                || (value == 922337203685477580 && digit > 7)) { return 0; }
        value = value * 10 + digit;
    }
    return value;
}

fn protocol_span(fields: Vector<String>, start: isize) -> Span {
    if (fields.length() != (start as usize) + 4) {
        return Span::call_site();
    }
    let line: Int64 = protocol_coord(fields.get(start));
    let column: Int64 = protocol_coord(fields.get(start + 1));
    let end_line: Int64 = protocol_coord(fields.get(start + 2));
    let end_column: Int64 = protocol_coord(fields.get(start + 3));
    if (line == 0 || column == 0 || end_line == 0 || end_column == 0) {
        return Span::call_site();
    }
    if (end_line < line || (end_line == line && end_column < column)) {
        return Span::call_site();
    }
    return Span { line, column, end_line, end_column };
}

fn protocol_span_text(span: Span) -> String {
    return span.line.to_string() + "\t" + span.column.to_string()
        + "\t" + span.end_line.to_string() + "\t" + span.end_column.to_string();
}

pub fn stream_from_stdin() -> TokenStream {
    let call: Span = protocol_span(protocol_fields(readline()), 0);
    ProcMacroCallSiteState::line = call.line;
    ProcMacroCallSiteState::column = call.column;
    ProcMacroCallSiteState::end_line = call.end_line;
    ProcMacroCallSiteState::end_column = call.end_column;
    let count: Int64 = Int64::from_string(readline());
    let mut tokens: Vector<Token> = [];
    let mut i: Int64 = 0;
    while (i < count) {
        let fields: Vector<String> = protocol_fields(readline());
        let text: String = readline();
        tokens.push_back(Token { fields.get(0), text, protocol_span(fields, 1) });
        i = i + 1;
    }
    return TokenStream { tokens };
}

pub fn stream_to_stdout(stream: TokenStream) {
    let mut i: usize = 0;
    while (i < stream.tokens.length()) {
        let tok: Token = stream.tokens.get(i as isize);
        print("T\t" + tok.kind + "\t" + protocol_span_text(tok.span) + "\t" + tok.text);
        i = i + 1;
    }
}

// -- 诊断 -----------------------------------------------------------------

fn protocol_message(message: String) -> String {
    let mut out: String = "";
    for b in message {
        let value: Int32 = b as Int32;
        if (value == 92) { out = out + "\\\\"; continue; }
        if (value == 10) { out = out + "\\n"; continue; }
        if (value == 13) { out = out + "\\r"; continue; }
        if (value == 9) { out = out + "\\t"; continue; }
        out = out + String::from_byte(b);
    }
    return out;
}

pub fn report(level: String, message: String) {
    report_at(level, message, Span::call_site());
}

pub fn report_at(level: String, message: String, span: Span) {
    print("D\t" + level + "\t" + protocol_span_text(span) + "\t" + protocol_message(message));
}

pub fn error_at(message: String, span: Span) {
    report_at("error", message, span);
}

pub fn warning_at(message: String, span: Span) {
    report_at("warning", message, span);
}

pub fn note_at(message: String, span: Span) {
    report_at("note", message, span);
}

pub fn error(message: String) {
    report("error", message);
}

pub fn warning(message: String) {
    report("warning", message);
}

pub fn note(message: String) {
    report("note", message);
}

// -- quote! 生成代码用的裸名入口 -------------------------------------------
//
// 表达式位的三段路径 (`std::proc_macro::f`) 会被解析器当枚举变体,
// 不可直接调用; quote! 生成代码只能发 1 段名, 因此这三个转发函数
// 经 prelude 重导出 (libs/mod.wind), 对所有文件可见。

pub fn quote_concat(parts: Vector<TokenStream>) -> TokenStream {
    return stream_concat(parts);
}

pub fn quote_of(tokens: Vector<Token>) -> TokenStream {
    return stream_of(tokens);
}

pub fn quote_tok(kind: String, text: String) -> Token {
    return Token { kind, text, Span::call_site() };
}

// -- 方法面 ---------------------------------------------------------------

extra Token {
    pub fn span(&self) -> Span {
        return self.span;
    }

    pub fn set_span(&mut self, span: Span) {
        self.span = span;
    }

    pub fn is_kind(&self, kind: String) -> Bool {
        return self.kind.eq(kind);
    }

    pub fn is_text(&self, text: String) -> Bool {
        return self.text.eq(text);
    }
}

extra TokenStream {
    pub fn span(&self) -> Span {
        if (self.tokens.length() == 0) { return Span::call_site(); }
        let first: Token = self.tokens.get(0);
        let last: Token = self.tokens.get((self.tokens.length() - 1) as isize);
        return Span { first.span.line, first.span.column, last.span.end_line, last.span.end_column };
    }

    pub fn length(&self) -> usize {
        return self.tokens.length();
    }

    pub fn get(&self, index: usize) -> Token {
        return self.tokens.get(index as isize);
    }

    pub fn push_token(&mut self, token: Token) {
        self.tokens.push_back(token);
    }

    /// 把 token 文本用空格拼成源码 (可被前端重新 lex)。
    pub fn source(&self) -> String {
        let mut out: String = "";
        let mut i: usize = 0;
        while (i < self.tokens.length()) {
            if (i > 0) {
                out = out + " ";
            }
            let tok: Token = self.tokens.get(i as isize);
            out = out + tok.text;
            i = i + 1;
        }
        return out;
    }
}

extra Diagnostic {
    pub fn error(message: String) -> Diagnostic {
        return Diagnostic::error_at(message, Span::call_site());
    }

    pub fn error_at(message: String, span: Span) -> Diagnostic {
        return Diagnostic { "error", message, span };
    }

    pub fn warning(message: String) -> Diagnostic {
        return Diagnostic::warning_at(message, Span::call_site());
    }

    pub fn warning_at(message: String, span: Span) -> Diagnostic {
        return Diagnostic { "warning", message, span };
    }

    pub fn note(message: String) -> Diagnostic {
        return Diagnostic::note_at(message, Span::call_site());
    }

    pub fn note_at(message: String, span: Span) -> Diagnostic {
        return Diagnostic { "note", message, span };
    }

    pub fn emit(&self) {
        report_at(self.level, self.message, self.span);
    }
}
