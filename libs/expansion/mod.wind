mod wrapping;
mod from_string;
mod empty_impl;
mod iter_vec;
mod iter_builtins;

use crate::traits::to_string::ToString;
use crate::traits::from::{From, Into};
use crate::traits::cmp::Eq;
use crate::builtins::*;
use crate::ctypedef::*;

macro_rules! impl_to_string {
    ($($ty:type),+ $(,)?) => {
        $(
            impl ToString for $ty {
                pub fn to_string(&self) -> String { return "{}".format(*self); }
            }
        )+
    };
}

impl ToString for String {
    pub fn to_string(&self) -> String { *self }
}

impl_to_string!(Bool, i8, i16, i32, i64, u8, u16, u32, u64, f32, f64, Int, UInt, Byte, Tuple);

// waiting for desugar(for-in to `Iterator`)
impl<T: ToString> ToString for Vector<T> {
    pub fn to_string(&self) -> String { return "{}".format(*self); }
}

impl<K: ToString, V: ToString> ToString for Map<K, V> {
    pub fn to_string(&self) -> String { return "{}".format(*self); }
}

impl<T: ToString> ToString for Set<T> {
    pub fn to_string(&self) -> String { return "{}".format(*self); }
}

extern "C" {
    fn strcmp(s1: &String, s2: &String) -> c_int;
}

impl Eq for String {
    fn eq(&self, other: &String) -> bool {
        return match strcmp(self, other) {
            0 => true,
            _ => false
        };
    }
}
