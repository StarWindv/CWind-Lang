fn sizeof_int<T: IsInteger>(number: &T) -> u8 {
    // 直接向上取整而不是四舍五入
    // 0.301 * 位数 + 1 -> 有符号
    // 0.301 * 位数     -> 无符号
    return match (typeof(number)) {
        "Int8"   => 5,
        "UInt8"  => 5,
        "Int16"  => 7,
        "UInt16" => 7,
        "Int"    => 7,
        "UInt"   => 7,
        "Int64"  => 21,
        "UInt64" => 21,
        _ => panic(&"It should not have occurred"),
    };
}
