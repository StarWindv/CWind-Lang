// std::expansion::i16 —— i16 的 Wrapping 实现 (纯 CWind, 对齐 Rust 语义).
use crate::traits::num_wrapping::Wrapping;

impl Wrapping<i16> for i16 {
    pub fn wrapping_add(self, other: i16) -> i16 {
        (((self as i32 + other as i32) + 32768) % 65536 - 32768) as i16
    }

    pub fn wrapping_sub(self, other: i16) -> i16 {
        (((self as i32 - other as i32) + 32768) % 65536 - 32768) as i16
    }

    pub fn wrapping_mul(self, other: i16) -> i16 {
        (((self as i32 * other as i32) + 32768) % 65536 - 32768) as i16
    }

    pub fn wrapping_div(self, other: i16) -> i16 {
        if ((self == -32768) && (other == -1)) {
            return self;
        }
        self / other
    }

    pub fn wrapping_rem(self, other: i16) -> i16 {
        if ((self == -32768) && (other == -1)) {
            return 0;
        }
        self % other
    }

    pub fn wrapping_neg(self) -> i16 {
        (0 - self) as i16
    }

    pub fn wrapping_abs(self) -> i16 {
        if (self < 0) {
            return (0 - self) as i16;
        }
        return self;
    }

    pub fn wrapping_shl(self, other: u32) -> i16 {
        ((self as i32) << (other % 16) & 0xFFFF) as i16
    }

    pub fn wrapping_shr(self, other: u32) -> i16 {
        ((self as i32) >> (other % 16)) as i16
    }

    pub fn wrapping_add_signed(self, other: i16) -> i16 {
        self.wrapping_add(other)
    }

    pub fn wrapping_sub_signed(self, other: i16) -> i16 {
        self.wrapping_sub(other)
    }

    pub fn wrapping_pow(self, other: u32) -> i16 {
        let mut result: i16 = 1;
        let mut base: i16 = self;
        let mut exp: u32 = other;
        while (exp != 0) {
            if ((exp % 2) == 1) {
                result = result.wrapping_mul(base);
            }
            base = base.wrapping_mul(base);
            exp = exp >> 1;
        }
        result
    }
}
