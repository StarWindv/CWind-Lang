use crate::traits::iterator::Iterator;
use crate::builtins::{Vector, VectorIter};
use crate::option::Option;


impl<T> Iterator for VectorIter<T> {
    type Item = T;
    fn next(&mut self) -> Option<Self::Item> {
        if self.count >= self._inner_vec.length() {
            return Option::None;
        }
        let result: T = self._inner_vec.get(self.count);
        self.count += 1;
        return Option::Some(result);
    }
}


impl<T> IntoIterator for Vector<T> {
    type Item = T;
    type IntoIter = VectorIter<T>;

    fn into_iter(self) -> Self::IntoIter {
        VectorIter {
            self,
            0,
        }
    }
}
