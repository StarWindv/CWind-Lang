use crate::traits::iterator::Iterator;
use crate::builtins::{Byte, StringIter};
use crate::option::Option;


impl Iterator for StringIter {
    type Item = Byte;
    fn next(&mut self) -> Option<Self::Item> {
        if self.count >= self._inner_str.length() {
            return Option::None;
        }
        let result: Byte = self._inner_str._next(self.count);
        self.count += 1;
        return Option::Some(result);
    }
}


impl IntoIterator for String {
    type Item = Byte;
    type IntoIter = StringIter;

    fn into_iter(self) -> Self::IntoIter {
        StringIter {
            self,
            0,
        }
    }
}
