// todo-132: 编译器内置类型与方法的声明站点.
// todo-154: 内置类型的 FQN 形式为 `std::builtins::Xxx`, 后端在类型
// intern 边界剥 `std::builtins::` 前缀.
//
// 这些声明是 `extern "CWind"` 块, 标识类型/方法为编译器内建.
// 通过 `libs/mod.wind` (prelude) 的 `pub mod builtins;` 重导出,
// 用户代码经 `use std::*` 可寻址到这些类型.
//
// 高层 trait (Display / From / Into) 的实现不在本模块, 而是在
// `libs/expansion/` 等模块中以普通 `extra` 或 `impl` 块完成.

pub extern "CWind" {
    // 基础容器 —— 未标记 const type: 不允许作为 const 值类型, 也不允许
    // 从 const-fn 返回 (const-fn 内部作局部变量仍可使用)。
    type Vector<T>;
    type Map<K, V>;
    type Set<T>;

    // const-type 标记: 允许作为 const 值类型与 const-fn 返回类型。
    // 判定走这张声明表 (sa: analyzer.const_types), 不按类型名硬编码。
    const type String;
    const type Tuple; // 需要修改至真正的 `(...)` 类型
    const type None;  // 无返回值类型 (声明面唯一来源; todo-162 前仍用 `-> None`)

    // 标量类型
    const type Int8;
    const type UInt8;
    const type Int16;
    const type UInt16;
    const type Int32;
    const type UInt32;
    const type Int64;
    const type UInt64;
    const type Int;
    const type UInt;
    const type Float;
    const type Float64;
    const type Byte;
    const type Bool;
}

pub extern "CWind" {
    // Vector
    fn Vector<T>::new() -> Self;
    // 预分配容量构造 (todo-140): rt 入口按 reserve 初始化, 元素类型
    // tag 由调用点期望类型上下文提供 (与 Vector::new 同纪律)。
    #[link_name = "cwvec_with_capacity"]
    fn Vector<T>::with_capacity(capacity: usize) -> Self;
    fn Vector<T>::length(&self) -> usize;
    fn Vector<T>::contains(&self, value: T) -> Bool;
    fn Vector<T>::push_back(&mut self, element: T);
    fn Vector<T>::pop_back(&mut self) -> T;
    fn Vector<T>::extend_with(&mut self, other: Vector<T>);
    fn Vector<T>::insert_at(&mut self, index: isize, value: T);
    fn Vector<T>::index_of(&self, value: T) -> usize;
    fn Vector<T>::get(&self, index: isize) -> T;
    fn Vector<T>::set(&mut self, index: isize, value: T);
    fn Vector<T>::remove_at(&mut self, index: isize);
    fn Vector<T>::clear(&mut self);
}

pub extern "CWind" {
    // String
    fn String::new() -> Self;
    // 标记为 const fn: 可在 const 初始化式中调用 (返回 usize 已标记)。
    const fn String::length(&self) -> usize;
    fn String::contains(&self, other: String) -> Bool;
    // 单字节构造 (todo-141): Byte 标量 -> 单字节 String
    #[link_name = "cw_builtin_str_from_byte"]
    fn String::from_byte(byte: Byte) -> String;
    // format 是编译器内建: 模板由 rt 栈机扫描, 无 CWind 函数体
    fn String::format(&self, ...) -> String;
}

pub extern "CWind" {
    // Map
    fn Map<K, V>::new() -> Self;
    fn Map<K, V>::length(&self) -> usize;
    fn Map<K, V>::contains(&self, key: K) -> Bool;
    fn Map<K, V>::get(&self, key: K) -> V;
    fn Map<K, V>::set(&mut self, key: K, value: V);
    fn Map<K, V>::remove(&mut self, key: K);
    fn Map<K, V>::clear(&mut self);
}

pub extern "CWind" {
    // Set
    fn Set<T>::new() -> Self;
    fn Set<T>::length(&self) -> usize;
    fn Set<T>::contains(&self, value: T) -> Bool;
    fn Set<T>::add(&mut self, value: T);
    fn Set<T>::remove(&mut self, value: T);
    fn Set<T>::clear(&mut self);
}

pub(std) extern "CWind" {
    fn Set<T>::_next(&self, index: usize) -> T;
    fn Map<K, V>::_next(&self, index: usize) -> Tuple<K, V>;
    fn String::_next(&self, index: usize) -> Byte;
}

pub extern "CWind" {
    // Tuple
    fn Tuple::length(&self) -> usize;
}

pub extern "CWind" {
    // builtins' funcs
    // addr_of(&value) -> UInt64: 持久地址观测 (FFI blob 直传/诊断用)
    // 标量取存储槽地址 / 指针取句柄地址 (指针值本身) / 结构体与
    // 定长数组取 blob 地址 / &T 借用恒等 (地址即被借存储)。
    fn addr_of<T>(value: &T) -> u64;
    fn readline() -> String;
    // 纯字节写出 (不追加换行); print 仍走 baseprint (字节 + 换行)
    fn _write(value: String);
    fn type_of<T>(value: T) -> String;
    fn typeof<T>(value: T) -> String;
    fn unwind() -> Vector<Map<String, String>>;
    fn exit(code: isize) -> !;
/*}

pub mod gc {
    pub extern "CWind" {
    */
        fn gc_collect();
        fn gc_alloc_bytes() -> u64;
        fn gc_live_bytes() -> u64;
        fn gc_pause_ns() -> u64;
        fn gc_enable(on: Bool);
    // }
}


extern "CWind" {
    fn baseprint(value: String);
}

pub fn print<T: ToString>(value: &T) {
    baseprint(value.to_string());
}

pub(std) extern "CWind" {
    // todo-214: 浮点无损转 String (Schubfach 最短往返, Rust Display 定点
    // 呈现: 无 6 位截断 / 永不科学计数 / 整数不带 .0)。rt 异构入口经
    // #[link_name] 直绑, 泛型实参 tid 由调用点第一实参静态类型提供;
    // print/to_string/String.format 仍走 %g, 互不影响。
    #[link_name = "cw_builtin_float_to_lossless_string"]
    fn float_to_lossless<T: IsFloat>(value: T) -> String;
}

macro_rules! impl_to_lossless_string {
    ($($ty:type),+ $(,)?) => {
        $(
            extra $ty {
                pub fn to_lossless_string(&self) -> String {
                    return float_to_lossless(*self);
                }
            }
        )+
    };
}

impl_to_lossless_string!(Float, Float64);


pub extern "CWind" {
    // String -> 标量解析共用 rt 的 cw_builtin_parse_owned 异构入口:
    // 调用点按 owner 类型提供 target_type_id (todo-179).
    #[link_name = "cw_builtin_parse_owned"]
    fn UInt64::from_string(s: String) -> UInt64;
    #[link_name = "cw_builtin_parse_owned"]
    fn Int64::from_string(s: String) -> Int64;
    #[link_name = "cw_builtin_parse_owned"]
    fn Float64::from_string(s: String) -> Float64;
}

pub typedef f64 = Float64;
pub typedef f32 = Float;
pub typedef Float32 = Float;

pub typedef i64 = Int64;
pub typedef i32 = Int32;
pub typedef i16 = Int16;
pub typedef i8  = Int8;

pub typedef u64 = UInt64;
pub typedef u32 = UInt32;
pub typedef u16 = UInt16;
pub typedef u8  = UInt8;

pub typedef bool = Bool;

#[cfg(target_pointer_width = "64")]
pub typedef usize = u64;

#[cfg(target_pointer_width = "32")]
pub typedef usize = u32;

#[cfg(target_pointer_width = "64")]
pub typedef isize = i64;

#[cfg(target_pointer_width = "32")]
pub typedef isize = i32;


pub struct VectorIter<T> {
    _inner_vec : Vector<T>,
    count: usize
}

// Map/Set/String 的按值迭代器共用: 元素经各自 `_next(index)` 逐个取出,
// 类型参数是**容器**本身 (IterBuiltins<Set<T>> / <Map<K, V>> / <String>).
pub struct IterBuiltins<T> {
    _inner: T,
    count: usize
}

// 不移动所有权的借用迭代器: 持有容器的 `&` 引用, Iterator/IntoIterator
// 实现见 libs/expansion/iter_*.wind 的 `Iter<容器>` 面.
pub struct Iter<T> {
    _inner: &T,
    count: usize
}

macro_rules! impl_consts {
    ($ty:type, $name1:ident, $value1:expr, $name2:ident, $value2:expr) => {
        extra $ty {
            pub const $name1: $ty = $value1;
            pub const $name2: $ty = $value2;
        }
    };
}

impl_consts!(i8,  MIN,  0x80,               MAX, 0x7F);
impl_consts!(i16, MIN,  0x8000,             MAX, 0x7FFF);
impl_consts!(i32, MIN,  0x80000000,         MAX, 0x7FFFFFFF);
impl_consts!(i64, MIN,  0x8000000000000000, MAX, 0x7FFFFFFFFFFFFFFF);

impl_consts!(u8,  MIN,  0, MAX, 0xFF);
impl_consts!(u16, MIN,  0, MAX, 0xFFFF);
impl_consts!(u32, MIN,  0, MAX, 0xFFFFFFFF);
impl_consts!(u64, MIN,  0, MAX, 0xFFFFFFFFFFFFFFFF);
