use crate::ctypedef::*;

pub extern "C" {
    pub fn malloc(size: c_size_t) -> *mut Byte;
    pub fn free(ptr: *mut Byte);
    pub fn realloc(ptr: *mut Byte, new_size: c_size_t) -> *mut Byte;
    pub fn calloc(count: c_size_t, size: c_size_t) -> *mut Byte;
    pub fn aligned_alloc(alignment: c_size_t, size: c_size_t) -> *mut Byte;
    pub fn memcpy(dest: *mut Byte, src: *const Byte, n: c_size_t) -> *mut Byte;
    pub fn memset(s: *mut Byte, c: c_int, n: c_size_t) -> *mut Byte;
    pub fn strlen(s: *const Byte) -> c_size_t;

    #[link_name = "srand"]
    pub fn random_seed(seed: c_uint);

    #[link_name = "rand"]
    pub fn randint() -> c_int;

    #[link_name = "atexit"]
    pub fn at_exit(func: fn()) -> c_int;

    #[link_name = "exit"]
    pub fn c_exit(status: c_int);

    // auto mapping to `char *`/`const char*`/`char []`
    pub fn system(cmd: &String) -> c_int;

    #[link_name = "abs"]
    pub fn i32_abs(x: c_int) -> c_int;

    #[link_name = "labs"]
    pub fn i64_abs(x: c_long) -> c_long;

    #[link_name = "getenv"]
    pub fn get_env(key: &String) -> Option<String>;
}
