use crate::ctypedef::*;


// Windows:
//  - MinGW-w64: 64-bit
// Unix:
//  - 按 ILP32/LP64 区分
#[cfg(all(unix, target_pointer_width = "64"))]
pub typedef time_t = Int64;

#[cfg(all(unix, target_pointer_width = "32"))]
pub typedef time_t = Int32;

#[cfg(not(unix))]
pub typedef time_t = Int64;

pub typedef clock_t = c_long;


/// struct tm
pub struct Time {
    pub time_sec  : c_int,
    pub time_min  : c_int,
    pub time_hour : c_int,
    pub time_mday : c_int,
    pub time_mon  : c_int,
    pub time_year : c_int,
    pub time_wday : c_int,
    pub time_yday : c_int,
    pub time_isdst: c_int,
}

pub struct Timespec {
    pub tv_sec: time_t,
    pub tv_nsec: c_long,
}

pub extern "C" {
    /// 自进程启动起的处理器时间.
    pub fn clock() -> clock_t;

    /// 秒级的日历时间; t 非 NULL 时同时写入 *t.
    /// CWind 侧传借用变量, 例如 `let now: time_t = time(&t0);`
    pub fn time(t: *mut time_t) -> time_t;

    /// UTC 时间下的分解时间 (返回指向静态缓冲的指针, 非线程安全).
    pub fn gmtime(timer: *const time_t) -> *mut Time;

    /// 本地时区下的分解时间 (返回指向静态缓冲的指针, 非线程安全).
    pub fn localtime(timer: *const time_t) -> *mut Time;

    /// 分解时间 -> 日历时间; 归一化字段会写回 *tm (出参模式).
    pub fn mktime(tm: *mut Time) -> time_t;

    /// t1 - t2 (秒).
    pub fn difftime(t1: time_t, t2: time_t) -> c_double;

    /// 可移植的时间获取 (TIME_UTC=1).
    #[cfg(unix)] // 需要使用 msys 的 ucrt, 懒得装了
    pub fn timespec_get(ts: *mut Timespec, base: c_int) -> c_int;
    #[cfg(unix)]
    pub fn clock_gettime(clock_id: c_int, ts: *mut Timespec) -> c_int;
}

// Windows 的 clock_gettime 实现在 winpthreads (libwinpthread-1.dll):
// 显式声明 link 依赖, 只有实际用到它的程序才链接线程运行库。
// MinGW 工具链默认动态链 winpthread, static kind 会与之冲突。
#[cfg(windows)]
#[link(name = "winpthread", kind = "dylib")]
pub extern "C" {
    pub fn clock_gettime(clock_id: c_int, ts: *mut Timespec) -> c_int;
}


/// TIME_UTC 的值 (<time.h>).
pub const TIME_UTC: c_int = 1;
pub const CLOCK_REALTIME : c_int = 0;
pub const CLOCK_MONOTONIC: c_int = 1;


#[cfg(target_os="windows")]
pub fn timespec_get(ts: *mut Timespec, base: c_int) -> c_int {
    match base {
        TIME_UTC => {
            let result: c_int = clock_gettime(CLOCK_REALTIME, ts);
            match result {
                0 => 1, // 问就是这么规定的, 我也没办法
                _ => 0,
            }
        },
        _ => 0,
    }
}
