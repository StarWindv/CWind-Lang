#[cfg(all(
    not(windows),
//     not(target_vendor = "apple"),
//     not(target_os = "vita"),
//     any(
//         target_arch = "aarch64",
//         target_arch = "arm",
//         target_arch = "csky",
//         target_arch = "hexagon",
//         target_arch = "msp430",
//         target_arch = "powerpc",
//         target_arch = "powerpc64",
//         target_arch = "riscv32",
//         target_arch = "riscv64",
//         target_arch = "s390x",
//         target_arch = "xtensa",
//     )
))]
typedef c_char  = u8;

#[cfg(all(
    target_os="windows",
    target_os="linux",
    target_os="macos",
    target_os="android",
))]
typedef c_char  = i8;

typedef c_schar  = i8;
typedef c_uchar  = u8;
typedef c_short  = i16;
typedef c_ushort = u16;

// type_alias! { c_int = c_int_definition::c_int;   }
// type_alias! { c_uint = c_int_definition::c_uint; }
//
// type_alias! { c_long = c_long_definition::c_long;   }
// type_alias! { c_ulong = c_long_definition::c_ulong; }

typedef c_longlong  = i64;
typedef c_ulonglong = u64;
typedef c_float     = f32;

