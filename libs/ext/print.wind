// std::ext::print — exported declarative wrappers around format!.
// Forward token trees unchanged so format! retains its accepted argument
// syntax, escape handling and diagnostics. Formatting itself remains a proc macro.

use crate::ext::format::format;


#[macro_export]
macro_rules! print {
    () => { std::io::stdio::_print(""); };
    ($($input:token)+) => {
        std::io::stdio::_print(format!($($input)+));
    };
}


#[macro_export]
macro_rules! println {
    () => { std::io::stdio::_print("\n"); };
    ($($input:token)+) => {
        std::io::stdio::_print(format!($($input)+));
        std::io::stdio::_print("\n");
    };
}


#[macro_export]
macro_rules! eprint {
    () => { std::io::stdio::_eprint(""); };
    ($($input:token)+) => { std::io::stdio::_eprint(format!($($input)+)); };
}


#[macro_export]
macro_rules! eprintln {
    () => { std::io::stdio::_eprint("\n"); };
    ($($input:token)+) => {
        std::io::stdio::_eprint(format!($($input)+));
        std::io::stdio::_eprint("\n");
    };
}
