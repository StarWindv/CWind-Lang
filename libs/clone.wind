use crate::builtins::*;

pub trait Clone {
    fn clone(&self) -> Self;
}


macro_rules! impl_clone {
    ($($ty:type),+ $(,)?) => {
        $(
            impl Clone for $ty {
                fn clone(&self) -> $ty { *self }
            }
        )+
    };
}

impl_clone!(i8, i16, i32, i64, u8, u16, u32, u64, Int, UInt, f32, f64);
impl_clone!(String, Bool, Byte);

impl Clone for &T {
    fn clone(&self) -> Self {
        self
    }
}
impl !Clone for &mut T {}


impl<T: Clone> Clone for Option<T> {
    fn clone(&self) -> Self<T> {
        match self {
            Some(value) => Some(value.clone()),
            None => None,
        }
    }
}

impl<T: Clone, E: Clone> Clone for Result<T, E> {
    fn clone(&self) -> Self<T, E> {
        match self {
            Ok(value) => Ok(value.clone()),
            Err(err) => Err(err.clone()),
        }
    }
}
