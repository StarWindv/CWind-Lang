/*
I want to make the node like this:
struct Node<K: Comparable, V> {
    pub k: K,
    pub v: V,
}
but there's no trait called 'comparable'
if it exists, the type 'UInt' and so on must implement it
*/

struct Node<T> {
    pub k: UInt,
    pub v: T,
}

// max heap
struct MaxHeap<T> {
    max_heap: Vector<Node<T>>,
    capacity: UInt,
    size: UInt
    // maybe we can use names like '_heap' for private fields
    // but it's said field's name couldn't start with symbols  qaq
}

extra<T> MaxHeap<T> {
    fn new(capacity: UInt) -> Self {
        let i: UInt = 0;
        let max_heap: Vector<Node<T>> = Vector::new();
        while(i <= capacity) {
            max_heap.push_back(None);    
            // I don't know if it could work
            // maybe we need a method like 'resize' or 'with_capacity'
            i += 1;
        }
        
        return MaxHeap<T> { max_heap, capacity, 0 };
    }

    fn insert(self, k: UInt, v: T) {
        if (self.size >= self.capacity) {
            return;
        }
        self.size += 1;
        self.max_heap[self.size] = Node<T> { k, v };
        Self::shift_up(self.size);
    }

    fn shift_up(self, i: UInt) {
        while (i > 1 && self.max_heap[i].k > self.max_heap[i / 2].k ) {
            Self::swap(i, i / 2);
            i /= 2;
        }
    }

    fn pop(self) -> Node<T> {
        if (self.size == 0) {
            return None;
        }
        let top_node: Node<T> = self.max_heap[1];
        self.max_heap[1] = self.max_heap[self.size];
        self.size -= 1;
        Self::shift_down(1);
        return top_node;
    }
    
    fn shift_down(self, i: UInt) {
        while (i * 2 <= self.size) {
            let j: UInt = i * 2;
            if (j + 1 <= self.size && self.max_heap[j + 1].k > self.max_heap[j].k) {
                j += 1;
            }
            if (self.max_heap[i].k > self.max_heap[j].k) {
                    break;
            }
            Self::swap(i, j);
            i = j;
        }
    }

    fn swap(self, i: UInt, j: UInt) {
        let this_node: Node<T> = self.max_heap[i];
        self.max_heap[i] = self.max_heap[j];
        self.max_heap[j] = this_node;
    }
}

