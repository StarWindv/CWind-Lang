type Age = Int where {
    self > 0;
    self < 100;
}

const Steve: Map<String, String> = {
    "name"  : "Steve",
    "hobby" : "swimming",
};

pub struct User {
    pub name: String,
    pub age : Age
}

pub trait JsonifyDisplay {
    pub fn to_json(self) -> String;
}

impl JsonifyDisplay for User {
    fn to_json(self) -> String {
        return "\
{
    \"name\": {},
    \"age\" : {}
}
".format(self.name, self.age);
    }
}


extra User {
    pub fn new(
        name: String,
        age : Int
    ) -> Self {
        return Self {
            name,
            age,
        };
    }
}


fn main() {
    let steve: User = User::new(Steve["name"], 999);
}
