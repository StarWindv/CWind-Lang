struct Hello {
    pub name: String
}

extra Hello {
    pub fn great(self) {
        builtins::print("Hello, {}!".format(self.name));
    }

    fn t(self) , which ::great {
        builtins::print("t");
    }
}
/*
思路是 inline, 也就是说, 编译后的复原码应该大概是这样的:
extra Hello {
    pub fn great(self) {
        builtins::print("Hello, {}!".format(self.name));

        // func t:
        builtins::print("t");
    }
}
// 同时不允许外部单独调用 which 钩子, 注册为了钩子函数那就只能作为钩子来自动运行
*/

fn main() {
    let hobj: Hello = Hello { "World" };
    hobj.great();
}
