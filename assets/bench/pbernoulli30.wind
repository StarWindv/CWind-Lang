use std::proc_macro::TokenStream;
use std::proc_macro::stream_of_token;
use std::proc_macro::token_literal;


fn binomial(n: u64, k: u64) -> u64 {
    if k == 0 || k == n {
        return 1;
    }
    binomial(n-1, k-1) + binomial(n-1, k)
}


fn bernoulli(n: u64) -> f64 {
    if n == 0 {
        return 1.0;
    }
    if n == 1 {
        return -0.5;
    }
    if n % 2 == 1 && n > 1 {
        return 0.0;
    }

    let mut sum: f64 = 0.0;
    let mut count: u64 = 0;
    loop {
        if count == n {
            break;
        }
        sum += binomial(n, count) as f64 * bernoulli(count) / (n - count + 1) as f64;
        count += 1;
    }
    -sum
}


#[proc_macro]
pub fn entry(input: TokenStream) -> TokenStream {
    let n: u64 = u64::from(input.source());
    stream_of_token(token_literal("\"" + bernoulli(n).to_string() + "\""))
}


fn main() {
    println!("{}", entry!(30));
}
