// Part1 边界用例
// 本文件故意不构成合法程序, 只测 token 切分; Parser/SA 失败属正常.
// [待定] = 文档未定义, 需要定夺
fn total() {
// ---- 1. 数字与小数点 ----
1.5;                       // Float: 1.5
1.;                        // [待定] 整数 1 + 方法调用 . ? 还是浮点 1. ? -> 数字是不能调用[dot]方法的, 报错
.5;                        // [待定] 方法调用 . [连接] 5 ? 还是浮点 .5 ? -> 什么都不是
1..2;                      // 1 .. 2 (解包符 ..) -> 不能对数字使用解包运算
1 . 5;                     // 1 . 5 (整数, 方法调用, 整数) -> 数字与空白字符不能做变量 -> 报错信息有问题
007;                       // 十进制 7 (前导零, 不是八进制) -> 合法, 等于 7
0;                         // 0
12345678901234567890;      // 超出标准 Int/UInt 范围, 词法应通过, 范围校验交给 SA

// ---- 2. 加减与正负号 ----
1 + + 2;                   // 两个 + (自增 ++ 已移除) -> lexer 能过, 生成 `Int Add Add Int`
1 + +2;                    // -> 1 [op:add] [op:positive] 2 -> 正确的, 也就是 `1 加 正 2` -> 没有赋值目标
1++2;                      // 应该报错 -> Wind has no postfix increment operator
1 - - 2;                   // 两个 - -> lexer 能过, 生成 `Int Minus Minus Int`
1--2;                      // 1 - - 2 (不是自减) -> Wind has no postfix decrement operator
-1;                        // 一元负号 -> Int 字面量, 无错误
a - b;                     // 减法 -> 正常

// ---- 3. 尖括号家族 ----
a < b;                     // <
a > b;                     // >
a <= b;                    // <=
a >= b;                    // >=
a << b;                    // <<
a >> b;                    // >>
a < < b;                   // 两个 <
a > > b;                   // 两个 >
a < : b;                   // < 与 : 两个 token -> `Identifier LeftAngle Colon Identifier`
a : > b;                   // : 与 > 两个 token -> `Identifier Colon RightAngle Identifier`
Vector<Vector<Int>>;       // 嵌套泛型收尾的 >> (Parser 负责拆分)
Vector<Int> : x;           // > 与 : 两个 token -> Parse Error

// ---- 4. 叹号家族 ----
a != b;                    // !=
a !< b;                    // !<
a !> b;                    // !>
a ! < b;                   // ! 与 < 两个 token
!a;                        // 否定
a ! b;                     // a ! b 三个 token

// ---- 5. 逻辑与位运算 ----
a && b;                    // &&
a || b;                    // ||
a & b;                     // &
a | b;                     // |
a & & b;                   // 两个 &
a | | b;                   // 两个 |

// ---- 6. 箭头与冒号 ----
a -> b;                    // ->
a - > b;                   // - 与 > 两个 token
a : b;                     // :
a :: b;                    // ::
a : : b;                   // 两个 :

// ---- 7. 点与解包 ----
a.b;                       // 方法调用
a . b;                     // a . b 三个 token
a..b;                      // a .. b
f(..x);                    // 方法调用参数中的解包
f( . . x );                // f ( . . x ) 两个点 token

// ---- 8. 注释边界 ----
// 行注释内的 // 不影响
/* 块注释内的 // 也不影响 */
let x: Int = 1 / * 注释 */ 2;   // 除法后跟块注释: 实际是 1 / 2 -> Parse Error -> 因为没有块注释开始所以后续的 */ 不是反块注释
a/*块注释*/b;                    // a 注释 b: 两个标识符 -> Parse Error -> Expected one of `:`, `;`, `=`, `@`, or `|`, found `b`

// ---- 9. 字符串与转义 ---- [ 无错区 ]
"double";                   // 双引号
'single';                   // 单引号
"it's";                     // 双引号内含单引号
'it\'s';                    // 单引号内转义单引号
"a\"b";                     // 双引号内转义双引号
'\'';                       // 单引号串, 内容是一个单引号
"";                         // 空串
'';                         // 空串
"line1\nline2\rline3\t\\ \0 \b \v";   // 全部特殊转义
"裸换行
第二行";                     // 裸换行: 现受支持
"{kv.key}";                 // 字符串内 {} 是字面量
'//不是注释';                // 字符串内的 // 不是注释
"/*不是注释*/";              // 字符串内的 /* 不是注释

// ---- 10. 标识符边界 ----
forx;                       // 标识符 (不是关键字 for)
letx;                       // 标识符
Int8;                       // 类型名
int8;                       // 标识符 (大小写敏感, 不是类型)
x1;                         // 数字结尾 OK
1x;                         // 数字 1 + 标识符 x (不能以数字开头)

// ---- 11. 保留关键字作为 token ----
lambda; import; use; as; when; define; async; await;


_x;                         // [待定] 下划线开头是否允许 -> 允许
中文;                       // [待定] 非 ASCII 标识符是否允许 -> 允许
$;                          // [待定] 保留符号 $ 的词法行为 -> 报错
#;                          // [待定] 保留符号 # 的词法行为 -> 报错
a$;                         // [待定] $ 是否可出现在标识符中 -> 报错
a#;                         // [待定] # 是否可出现在标识符中 -> 报错
1e3;                        // [待定] 科学计数法: 切为 1 和 e3? -> 暂不支持
"\{";                       // [待定] 非格式化串中的 \{ 转义 -> 报错, 没有这样的转义序列

// 以下内容注释掉了: 这些"应该"在词法阶段报错 (取消注释逐个测试)
// a ~ b; // 1. 未知字符
// a ? b; // 2. 未知字符
// `a`; // 3. 反引号
// "abc // 4. 未闭合字符串
// /* abc // 5. 未闭合注释
// "\q" // 6. 非法转义 -> 我们除了定义好的基础转义序列, 还应该支持
/**
 *
 * \x[Hex 1][Hex 2]
 * \u{1~6个Hex} 比如 let me: String "\u{7FFF}"
 * \n
 * \r
 * \t
 * \b
 * \v
 * \0
 * \\
 * \"
 * \'
 */
}
