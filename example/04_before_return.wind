pub struct User {
    pub name : String,
    pub age  : Int,
    pub email: String,
    static introduce_counter : UInt32 = 0;
}

extra User {
    pub fn new(
        name : String,
        age  : Int,
        email: String
    ) -> Self {
        return Self {
            name, age, email
        };
    }

    pub fn introduce(&self) -> String {
        return format!(
            "My name is {}. I'm {} years old.\nMy email address is {}, You can send me an email.",
                self.name,
                self.age,
                self.email
        );
    }

    fn increment(&self), after ::introduce {
        Self::introduce_counter += 1;
    }
}

fn main() {
    let Steve: User = User::new("Steve", 18, "steve@example.com");
    println!("{}", &Steve.introduce());
    println!("{}", User::introduce_counter);
    Steve.introduce();
    Steve.introduce();
    println!("{}", User::introduce_counter);
}
