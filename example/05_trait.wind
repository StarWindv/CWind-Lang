pub trait DisplayJson {
    pub fn to_json(self) -> String;
}


impl<T: Into<String>> DisplayJson for Map<String, T> {
    fn to_json(self) -> String {
        let result: String = "{";
        for (kv: self.entry()) {
            result += '\n    "{}": "{}"'.format(kv.0, kv.1.to_string());
        }
        result += "\n}";
        return result;
    }
}

const Data1: Map<String, Int> = {
    "CWind": 0,
};
const Data2: Map<String, Vector<UInt8>> = {
    "Version": [1, 2, 3],
};

fn main() {
    builtins::print(Data1.to_json());
    builtins::print(Data2);
}
