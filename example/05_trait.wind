pub trait DisplayJson {
    pub fn to_json(self) -> String;
}


impl<T: Into<String>> DisplayJson for Map<String, T> {
    fn to_json(self) -> String {
        let mut result: String = "{";
        for kv in self {
            result += '\n    "{}": "{}"'.format(kv.0, kv.1.into());
        }
        result += "\n}";
        result
    }
}

const Data1: Map<String, Int> = {
    "CWind": 0,
};
const Data2: Map<String, Vector<Float>> = {
    "Version": [0.0, 0.1],
};

fn main() {
    println!("{}", Data1.to_json());
    println!("{}", Data2.to_json());
}
