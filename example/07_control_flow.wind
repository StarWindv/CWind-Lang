fn classify(n: Int) -> String {
    if (n < 0) {
        return "negative";
    } elif (n == 0) {
        return "zero";
    } else {
        return "positive";
    }
}

fn main() -> Int {
    print(classify(-5));
    print(classify(0));
    print(classify(7));

    let mut i: Int = 0;
    while (i < 3) {
        i += 1;
    }
    print(i);

    let v: Vector<Int> = [1, 2, 3, 4, 5];
    let mut sum: Int = 0;
    for x in v {
        if (x % 2 == 0) {
            continue;
        }
        sum += x;
    }
    print(sum);
    return 0;
}
