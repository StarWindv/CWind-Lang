fn main() -> Int {
    let v: Vector<Int> = [1, 2, 3];
    v.push_back(4);
    v[0] = 10;
    print(v.length());
    print(v[0] + v[3]);

    let mut total: Int = 0;
    for x in v {
        total += x;
    }
    print(total);

    let scores: Map<String, Int> = { "alice": 90, "bob": 85 };
    scores["carol"] = 78;
    print(scores["alice"]);
    print(scores.contains("bob"));
    print(scores.length());
    for kv in scores.entry() {
        print(kv.1);
    }

    let tags: Set<String> = Set::new();
    tags.add("red");
    tags.add("blue");
    tags.add("red");
    print(tags.length());
    print(tags.contains("red"));
    for t in tags {
        print(t);
    }

    let pair: Tuple<String, Int> = ("age", 18);
    print(pair.0);
    print(pair[1]);
    return 0;
}
