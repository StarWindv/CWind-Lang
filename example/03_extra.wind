pub struct User {
    pub name : String,
    pub age  : Int,
    pub email: String
}

extra User {
    pub fn new(
        name : String,
        age  : Int,
        email: String
    ) -> Self {
        return Self {
            name, age, email
        };
    }
}

fn main() {
    let Steve: User = User::new("Steve", 18, "steve@example.com");
    println!( "My name is {}. I'm {} years old.\nMy email address is {}, You can send me an email.",
            Steve.name, Steve.age, Steve.email
    );
}
