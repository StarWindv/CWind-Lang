pub struct User {
    pub name : String,
    pub age  : Int,
    pub email: String
}

extra User {
    pub fn new(
        name : String,
        age  : Int,
        email: String
    ) -> Self {
        return Self {
            name, age, email
        };
    }
}

fn main() {
    let Steve: User = User::new("Steve", 18, "steve@example.com");
    builtins::print(
        ("My name is {}. I'm {} years old.\n"
        + "My email address is {}, You can send me an email.").format(
            Steve.name, Steve.age, Steve.email
        )
    );
}
