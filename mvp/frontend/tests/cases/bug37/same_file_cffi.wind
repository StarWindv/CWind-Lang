typedef i32 = Int32;

extern "C" {
    fn atexit(func: fn()) -> i32;
}

fn clean() {
    print("clean");
}

fn main() {
    let result: i32 = atexit(clean);
    print(result);
}
extern "CWind" {
    fn baseprint(value: String);
}

fn print<T: ToString>(value: &T) {
    baseprint(value.to_string());
}
