// recursive 的层数有硬上限 (展开线性放大代码体积): 超过就不展开, 告警说清
// 是哪一条 —— 与"形状不匹配"是两回事, 所以文案也不同。
#[opt(inline_loop(recursive = 100))]
fn f(n: i32) -> i32 {
    if n <= 1 {
        return n;
    }
    return f(n - 1) + f(n - 2);
}

fn main() -> Int32 {
    let mut i: Int32 = 0;
    while i <= 5 {
        let v: i32 = f(i);
        if v == 0 {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}
