// 路线 C: 自调用在 match 的 subject 位 —— subject 每次执行该 match 恰好
// 求值一次, 所以提到语句位是安全的。
#[opt(inline_loop(recursive = 2))]
fn f(n: i32) -> i32 {
    if n <= 0 {
        return 0;
    }
    match f(n - 1) {
        0 => 0,
        v => v + 1,
    }
}

fn main() -> Int32 {
    let mut i: Int32 = 0;
    while i <= 5 {
        let v: i32 = f(i);
        if v == 0 {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}
