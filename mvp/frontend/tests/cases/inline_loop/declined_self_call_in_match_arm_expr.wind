// **表达式**臂体 (Rust 风格 `A => expr`): 没有块就没有语句可挂, 提到外层
// 语句位会让"臂没被选中时"的那次调用也执行 —— 拒绝。
#[opt(inline_loop(recursive = 2))]
fn f(n: i32) -> i32 {
    if n <= 0 {
        return 0;
    }
    match (n % 2) {
        0 => f(n - 1),
        _ => f(n - 2),
    }
}

fn main() -> Int32 {
    let mut i: Int32 = 0;
    while i <= 5 {
        let v: i32 = f(i);
        if v == 0 {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}
