// 体里有闭包: 闭包体里的 `return` 归**闭包自己**, 改写成"写结果槽 + 跳出
// 包装环"就改错了 —— 拒绝。
#[opt(inline_loop(recursive = 2))]
fn f(n: i32) -> i32 {
    if n <= 0 {
        return 0;
    }
    let g: fn(Int32) -> Int32 = |x: Int32| -> Int32 { x + f(n - 1) };
    return g(1);
}

fn main() -> Int32 {
    let mut i: Int32 = 0;
    while i <= 3 {
        let v: i32 = f(i);
        if v == 0 {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}
