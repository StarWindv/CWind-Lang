// 体里有**两处**自调用: "内联哪一处" / "新一层的参数取谁的实参" 都没有唯一
// 定义, 与路线 B 同一个理由 —— 拒绝。
#[opt(inline_loop(recursive = 2))]
fn f(n: i32) -> i32 {
    if n <= 0 {
        return 1;
    }
    let a: i32 = f(n - 1);
    let b: i32 = f(n - 2);
    return a + b;
}

fn main() -> Int32 {
    let mut i: Int32 = 0;
    while i <= 5 {
        let v: i32 = f(i);
        if v == 0 {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}
