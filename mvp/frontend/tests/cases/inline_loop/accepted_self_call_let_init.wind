// 路线 C: 自调用在 let 初值位 —— 宿主语句是那条 let, 包装环插在它前面,
// 所以它仍然恰好在那条 let 需要值的时候求值一次。
#[opt(inline_loop(recursive = 2))]
fn f(n: i32) -> i32 {
    if n <= 0 {
        return 1;
    }
    let a: i32 = f(n - 1);
    let b: i32 = a * 2;
    return b;
}

fn main() -> Int32 {
    let mut i: Int32 = 0;
    while i <= 5 {
        let v: i32 = f(i);
        if v == 0 {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}
