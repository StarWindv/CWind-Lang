// `&&` / `||` 的右操作数会**短路**: 左假时压根不求值。提到语句位会把一次
// 可选执行变成每次执行 —— 拒绝。
#[opt(inline_loop(recursive = 2))]
fn f(n: i32) -> bool {
    if n <= 0 {
        return false;
    }
    let mut s: bool = false;
    if n > 2 && f(n - 1) {
        s = true;
    }
    return s;
}

fn main() -> Int32 {
    let mut i: Int32 = 0;
    while i <= 3 {
        let v: bool = f(i);
        if v {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}
