// 路线 C: 两个按值标量形参 (路线 C 不要求实参是"纯标量算术" —— 实参就在
// 代码里那个固定位置求值一次, 与路线 B 每轮重算不同)。
#[opt(inline_loop(recursive = 2))]
fn f(a: i32, b: i32) -> i32 {
    if b == 0 {
        return a;
    }
    let mut s: i32 = 0;
    let mut i: i32 = 0;
    loop {
        if i >= 2 {
            break;
        }
        s = s + f(a - 1, b - 1);
        i = i + 1;
    }
    return s + a;
}

fn main() -> Int32 {
    let mut b: i32 = 0;
    while b <= 3 {
        let v: i32 = f(5, b);
        if v == 0 {
            return 1;
        }
        b = b + 1;
    }
    return 0;
}
