// 臂守卫是**条件**求值的 (一条 match 可以对好几个臂各求值一次), 提到语句位
// 会把"原程序可能一次都不执行"的调用执行成 N 次 —— 拒绝, 只告警。
#[opt(inline_loop(recursive = 2))]
fn f(n: i32) -> i32 {
    if n <= 0 {
        return 0;
    }
    let mut s: i32 = 0;
    match (n % 3) {
        0 if f(n - 1) > 0 => {
            s = 1;
        },
        _ => {
            s = 2;
        },
    }
    return s;
}

fn main() -> Int32 {
    let mut i: Int32 = 0;
    while i <= 3 {
        let v: i32 = f(i);
        if v == 0 {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}
