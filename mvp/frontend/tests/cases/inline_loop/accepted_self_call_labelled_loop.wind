// 路线 C: 被克隆的体里带**用户自己的标签**。用户的 'outer 原样保留;
// 生成的 break 带自己的标签, 所以两者不会互相命中。
#[opt(inline_loop(recursive = 2))]
fn f(n: i32) -> i32 {
    if n <= 0 {
        return 0;
    }
    let mut s: i32 = 0;
    let mut i: i32 = 0;
    'outer: loop {
        if i >= 2 {
            break 'outer;
        }
        i = i + 1;
        s = s + f(n - 1);
    }
    return s;
}

fn main() -> Int32 {
    let mut i: Int32 = 0;
    while i <= 5 {
        let v: i32 = f(i);
        if v == 0 {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}
