pub trait Hasher {
    fn write(&mut self, bytes: &Vector<u8>);

    fn write_u8(&mut self, i: u8) {
        self.write(&[i])
    }
}

struct Sink { n: Int }

impl Hasher for Sink {
    fn write(&mut self, bytes: &Vector<u8>) {
        self.n = self.n + bytes.length();
    }
}

fn main() -> Int {
    let mut s: Sink = Sink { 0 };
    s.write_u8(1);
    s.write_u8(2);
    return s.n;
}
