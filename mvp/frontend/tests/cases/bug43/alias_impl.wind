pub trait MyT<T> {
    fn get(self) -> T;
}

typedef i32 = Int32;

impl MyT<i32> for i32 {
    fn get(self) -> i32 {
        return self;
    }
}

fn main() {
    let x: i32 = 3;
    print(x.get());
}
extern "CWind" {
    fn baseprint(value: String);
}

fn print<T: ToString>(value: &T) {
    baseprint(value.to_string());
}
