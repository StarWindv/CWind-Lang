// bug-67: `expr` 片段允许以一元 `*` 起始; guard 位 `if` 同测.
// 被指类型取 Copy (Int): `*msg` 从 &String 取值是 Rust E0507, 不是本
// 用例的考察点.
macro_rules! match_it {
    ($expression:expr, $pattern:pat $(if $guard:expr)? $(,)?) => {
        match $expression {
            $pattern $(if $guard)? => true,
            _ => false
        }
    };
}

fn b67(n: &Int) -> Bool {
    match_it!(*n, n if n == n)
}

fn main() -> Int {
    let v: Int = 3;
    if b67(&v) { return 1; }
    return 0;
}
