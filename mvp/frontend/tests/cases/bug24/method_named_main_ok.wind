struct Counter {
    n: Int
}

extra Counter {
    fn main(&self) -> None {
        print(self.n)
    }
}

fn main() -> Int32 {
    let c: Counter = Counter { 7 };
    c.main();
    0
}
extern "CWind" {
    fn baseprint(value: String);
}

fn print<T: ToString>(value: &T) {
    baseprint(value.to_string());
}
