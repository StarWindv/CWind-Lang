// entry 自身声明 trait + impl: registry 会再 parse 一遍入口,
// 若按 id 去重会把入口再拉一次 (bug-61 self-pull) -> duplicate definition/impl.
use modules::greet::greet;

pub trait ArgString {
    fn to_arg_string(self) -> String;
}

// 目标类型原先写作 `Vec<T>` —— 那时 prelude 里有 `pub typedef Vec<T> =
// Vector<T>;`; 别名撤掉后直接写本体 `Vector<T>` (本用例验的是 bug-61 的
// self-pull, 与目标类型无关)。
impl<T: ToString> ArgString for Vector<T> {
    fn to_arg_string(self) -> String {
        let mut result: String = "";
        for ele in self {
            result += ele.to_string();
        }
        result
    }
}

fn main() {
    println!("{}", greet());
}
