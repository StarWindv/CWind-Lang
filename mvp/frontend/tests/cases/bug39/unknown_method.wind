struct Box<T> {
    v: T,
}

extra<T> Box<T> {
    fn get(self) -> T {
        self.v
    }
}

fn main() {
    let b: Box<String> = Box<String> { "a" };
    print(b.gett());
}
extern "CWind" {
    fn baseprint(value: String);
}

fn print<T: ToString>(value: &T) {
    baseprint(value.to_string());
}
