// 独立回归: Display print / From-Into 自动转换 / Self<T> 绑定 /
// 空 for-in 函数体 / format 参数配平

struct User;

impl Display for User {
    fn to_string(&self) -> String {
        return "UserString";
    }
}

struct Counter {
    n: Int,
}

extra Counter {
    fn value(&self) -> Int {
        return self.n;
    }
}

impl<T> From<Vector<T>> for Set<T> {
    fn from(array: Vector<T>) -> Self<T> {
        let result: Set<T> = Set::new();
        for ele in array {
            result.add(ele);
        }
        return result;
    }
}

fn peek(v: &Vector<Int>) -> UInt {
    return v.length();
}

fn main() -> Int {
    let u: User = User {};
    print(u);
    print(u.to_string());

    let c: Counter = Counter { 7 };
    print(c.value());
    print(c.value());

    let array: Vector<Int> = [1, 1, 2, 3, 4, 1];
    let set: Set<Int> = array.into();
    print(set);

    let v: Vector<Int> = [1, 2, 3];
    print(peek(&v));
    print(peek(&v));

    let x: Int = 42;
    let ok: Bool = true;
    print("v={}, b={}".format(x, ok));
    return 0;
}
