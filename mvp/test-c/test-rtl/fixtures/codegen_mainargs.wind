// bug-30: main 接收程序参数
// 后端 C 入口带 (argc, argv), 用户 main 声明一个 Vector<String> 形参时,
// rt 把 argv[1..argc) 打包成 Vector<String> 注入 (零拷贝引用 argv 字节)。
// 以 EXE_ARGS=alpha;beta 运行: 输出 2;alpha;beta (每行一个), 退出码 0

fn main(args: Vector<String>) {
    print(args.length());
    for s in args {
        print(s);
    }
}
