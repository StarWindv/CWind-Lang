struct Point { x: Int, y: Int }
extra Point {
    fn sum(self) -> Int {
        return self.x + self.y;
    }
    fn new(x: Int, y: Int) -> Point {
        return Point { x, y };
    }
}
fn double(p: Point) -> Point {
    return Point { p.x * 2, p.y * 2 };
}
fn main() -> Int {
    let mut p: Point = Point { 3, 4 };
    print(p.x);
    print(p.y);
    p.x = 9;
    print(p.x);
    print(p.sum());
    let q: Point = Point::new(1, 2);
    print(q.x);
    print(q.y);
    let d: Point = double(q);
    print(d.x);
    print(d.y);
    return 7;
}
