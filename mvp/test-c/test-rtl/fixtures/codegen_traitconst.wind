pub trait DisplayJson {
    pub fn to_json(self) -> String;
}

impl<T: ToString> DisplayJson for Map<String, T> {
    fn to_json(self) -> String {
        let mut result: String = "{";
        for (k, v) in self {
            result += '\n    "{}": "{}"'.format(k, v.to_string());
        }
        result += "\n}";
        return result;
    }
}

fn main() {
    // 容器不再是 const 类型 (堆分配), 改为局部 let — 语义不变。
    let Data: Map<String, Int> = {
        "CWind": 0
    };
    builtins::print(Data.to_json());
}
