// bug-37: ①同文件无名 extern 块的 cffi 函数可裸名调用 (之前被
// _reject_hidden 误报 "belongs to another module"); ②extern 函数可标记
// 发散 (`-> !`, 映射 C noreturn/void, 如 exit)。
// atexit 注册 CWind 函数 clean 作回调 (todo-54 适配器);
// cexit(7) 调 C exit(7) -> 先打印 0, atexit 回调打印 clean, 退出码 7。
// 输出 0;clean (每行一个), 退出码 7

extern "C" {
    fn atexit(func: fn()) -> i32;
    #[link_name = "exit"]
    fn cexit(status: i32) -> !;
}

fn clean() {
    print("clean");
}

fn main() -> Int {
    let result: i32 = atexit(clean);
    print(result);
    cexit(7);
    return 0;
}
