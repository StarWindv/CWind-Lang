// bug-47: 泛型容器字面量初始化时 SA 主动绑定注解的元素数值类型
// (哪怕元素写的是裸字面量); bug-48: 容器内的类型别名先展开再比较。
struct Sample { vs: Vector<f64> }

fn sum(v: &Vector<f64>) -> f64 {
    let mut acc: f64 = 0.0;
    for x in v {
        acc = acc + x;
    }
    return acc;
}

fn main() -> Int {
    // 裸浮点字面量绑定到注解的 f64 (-> Float64)
    let v: Vector<f64> = [1.5, 2.25, 3.125];
    print(v.length());
    print(v[0] + v[1] + v[2]);
    print(sum(&v));

    // `as` 转型过的元素同样绑定
    let w: Vector<f64> = [1.0 as f64, 2.0 as f64];
    print(w[1]);

    // Map 字面量的键/值位绑定
    let m: Map<String, f64> = {"a": 1.5, "b": 2.5};
    print(m["a"] + m["b"]);

    // 嵌套容器: 别名在实参位展开 (bug-48)
    let n: Vector<Vector<f64>> = [[1.0, 2.0], [3.0]];
    print(n.length() + n[0].length() + n[1].length());

    // 结构体字段位也是容器注解
    let s: Sample = Sample { [10.5, 20.25] };
    print(s.vs[1]);
    return 0;
}
