// bug-35: 结构体含定长内联数组时, extra 内的 `Self { [0 as UInt32; 624], ... }`
// 之前出现一串奇怪的解析错误。修复后 `[x; N]` 重复字面量按定长数组构造。
// 输出 42;0;624 (每行一个), 退出码 0

pub struct MT19937 {
    state: [u32; 624],
    index: u64,
}

extra MT19937 {
    pub fn new(seed: u32) -> Self {
        let mut mt: MT19937 = Self {
            [0 as UInt32; 624],
            624 as UInt64,
        };
        mt
    }
}

fn main() -> Int {
    let mut mt: MT19937 = MT19937::new(0);
    mt.state[0] = 42;
    print(mt.state[0]);
    print(mt.state[623]);
    print(mt.index);
    return 0;
}
