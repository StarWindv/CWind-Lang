fn tail(a: Int, b: Int) -> Int {
    a * 2 + b
}

struct Point {
    x: Int,
    y: Int,
}

fn mutate() -> Int {
    let mut n: Int = 3;
    n += 4;
    let mut p: Point = Point { 5, 6 };
    p.x = 7;
    tail(n, p.x)
}

fn main() -> Int {
    print(mutate());
    let mut s: String = "tail";
    s += " mut";
    print(s);
    return 17;
}
