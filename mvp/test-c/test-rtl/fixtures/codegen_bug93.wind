// bug-93: 自由泛型函数的类型实参要能**穿过指针/引用**推断出来
//
// SA 的 `_unify_generic` 原先只对结构化拼写 (`Vector<T>` vs `Vector<Int>`)
// 逐位递归。裸指针拼写 `*mut T` 两侧 `_split_args` 都是空 —— 没有任何
// `<` 可跟随, T 永远绑不上, 自由函数又没有接收者兜底, 于是调用点报
// `Cannot initialize Int32 with T`。方法路径看着"能用"只是因为 T 来自
// 接收者 (bug-90 修的是单态化时的拼写代入, 另一半)。
//
// 语义 (同 Rust): `&mut i32` -> `*mut T` 是 coercion site, 推断变量绑到
// **被指类型**, 所以 `read_at(&mut raw, 0)` 得 T = i32。
//
// 本用例钉的是**运行结果**: 推断出来的实例必须真的能按那个宽度读写。
// 比较一律经过一个**带类型的局部** (`let a: i32 = read_at(...)`), 顺带
// 也钉住"推断出的 T 真的替换进了返回类型"这件事本身。
//
// 刻意**不**覆盖的一处: `read_via_ref(&mut raw[0], 0)` —— 对一个
// `&mut T` **绑定**做下标 (`p[i]`, p 是引用而不是裸指针)。那是另一条
// 既有的后端缺口 (cg_expr_index 看到的是被借类型 `Int32` 而不是指针,
// 报 "only Vector/Map/Tuple index reads are supported"), 与泛型推断无关
// 且在改动前的树上同样失败, 不在 bug-93 范围内。

use std::core::alloc::*;

// T 只出现在指针/引用位, 返回 T
fn read_at<T>(p: *mut T, i: i32) -> T {
    return p[i];
}

fn write_at<T>(mut p: *mut T, i: i32, v: T) {
    p[i] = v;
}

fn read_const_at<T>(p: *const T, i: i32) -> T {
    return p[i];
}

fn read0<T>(p: *mut T) -> T {
    return *p;
}

fn main() -> Int32 {
    let mut fails: Int32 = 0;
    let mut raw: *mut i32 = alloc(128) as *mut i32;
    raw[3] = 11;
    raw[0] = 5;

    // 1) T 从裸指针实参推断
    let a1: i32 = read_at(raw, 3);
    if a1 != 11 { println!("bad: infer *mut"); fails = fails + 1; }

    // 2) 泛型写回必须落在同一槽 (步长随实例)
    write_at(raw, 3, 42);
    let a2: i32 = read_at(raw, 3);
    if a2 != 42 { println!("bad: generic write"); fails = fails + 1; }

    // 3) *p 读 (元素 0)
    let a3: i32 = read0(raw);
    if a3 != 5 { println!("bad: *p read"); fails = fails + 1; }

    // 4) *const 路径
    let a4: i32 = read_const_at(raw as *const i32, 3);
    if a4 != 42 { println!("bad: *const infer"); fails = fails + 1; }

    // 5) 槽宽必须随实例走: i64 槽 8B, 超 i32 范围的值读回必须一致
    let mut r8: *mut i64 = alloc(128) as *mut i64;
    r8[1] = 4294967296;
    let a5: i64 = read_at(r8, 1);
    if a5 != 4294967296 { println!("bad: i64 slot read"); fails = fails + 1; }
    write_at(r8, 1, 8589934592);
    let a6: i64 = read_at(r8, 1);
    if a6 != 8589934592 { println!("bad: i64 slot write"); fails = fails + 1; }

    // 6) 同一模板的另一个实例不能串槽
    let a7: i32 = read_at(raw, 3);
    if a7 != 42 { println!("bad: cross-instance bleed"); fails = fails + 1; }

    // 7) 引用实参传给 *mut T 形参 (bug-93 与 bug-95 的交界, 依赖 bug-95
    //    的别名修复: 引用实参必须透传被借存储地址而不是被解引用内联)
    let a9: i32 = read_at(&mut raw[3], 0);
    if a9 != 42 { println!("bad: &mut arg -> *mut T param"); fails = fails + 1; }

    println!("{}", fails);
    free(raw as *mut u8);
    free(r8 as *mut u8);
    if fails != 0 {
        println!("MISMATCH");
        return 1;
    }
    println!("all match");
    return 0;
}
