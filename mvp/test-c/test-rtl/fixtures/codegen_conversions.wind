// String 解析回归: From<String> 仅宽类型路径 (Int64/UInt64/Float64),
// via rt cw_builtin_parse_owned 异构入口 (todo-180 link_name)。
fn main() -> Int {
    let i: Int64 = Int64::from("7");
    let u64: UInt64 = UInt64::from("18446744073709551615");
    let f64: Float64 = Float64::from("2.25");
    print(i);
    print(u64);
    print(f64);
    let s: String = u64.into();
    print(s);
    let n: UInt64 = "42".into();
    print(n);
    return 0;
}
