// bug-91 follow-up: #[opt(inline_loop)] 路线 C 的**控制流**回归。
//
// 路线 C 把整个函数体克隆 N 份, 每份套一个带标签的包装环, 好让副本里的
// `return X` 变成 `r = X; break 'label`。它成立的前提是一条控制流事实:
//
//     包装环是**函数体副本的最外层环**, 所以副本里每个不带标签的
//     break / continue 外面都严格套着一个用户自己的环 —— 取"最内层环"
//     命中的仍是用户的环, 不是包装环。
//
// 下面这组用例就是来打掉这个前提的: 自调用点**故意落在用户环内部**, 于是
// 包装环被嵌进那个用户环里(而不是包在外面), 无标签/带标签跳转都隔着包装环。
// 一旦包装环抢到了跳转, 控制流就变了, 与右侧朴素递归的数值就对不上。
//
// 每对 (标注版, 朴素对照) 同居一个文件, 运行时逐值互校 —— 数值不一致就
// 直接打印 MISMATCH 并以非零码退出, 不依赖测试框架去比对两份产物。

// (1) 无标签 break, 调用点在同一个环里
#[opt(inline_loop(recursive = 3))]
fn brk(n: i32) -> i32 {
    if n <= 0 { return 0; }
    let mut s: i32 = 0;
    let mut i: i32 = 0;
    while i < n {
        if i == 2 { break; }
        s = s + i;
        i = i + 1;
    }
    return s + brk(n - 1);
}
fn brk_ref(n: i32) -> i32 {
    if n <= 0 { return 0; }
    let mut s: i32 = 0;
    let mut i: i32 = 0;
    while i < n {
        if i == 2 { break; }
        s = s + i;
        i = i + 1;
    }
    return s + brk_ref(n - 1);
}

// (2) 无标签 continue
#[opt(inline_loop(recursive = 2))]
fn cont(n: i32) -> i32 {
    if n <= 0 { return 0; }
    let mut s: i32 = 0;
    let mut i: i32 = 0;
    while i < n {
        if i % 2 == 0 { i = i + 1; continue; }
        s = s + i;
        i = i + 1;
    }
    return s + cont(n - 1);
}
fn cont_ref(n: i32) -> i32 {
    if n <= 0 { return 0; }
    let mut s: i32 = 0;
    let mut i: i32 = 0;
    while i < n {
        if i % 2 == 0 { i = i + 1; continue; }
        s = s + i;
        i = i + 1;
    }
    return s + cont_ref(n - 1);
}

// (3) 带标签 break: 标签必须仍指向用户的环, 不能被包装环吃掉
#[opt(inline_loop(recursive = 3))]
fn lbl(n: i32) -> i32 {
    if n <= 0 { return 0; }
    let mut s: i32 = 0;
    let mut i: i32 = 0;
    'outer: while i < n {
        let mut j: i32 = 0;
        while j < 3 {
            if j == 1 { break 'outer; }
            s = s + 1;
            j = j + 1;
        }
        i = i + 1;
    }
    return s + lbl(n - 1);
}
fn lbl_ref(n: i32) -> i32 {
    if n <= 0 { return 0; }
    let mut s: i32 = 0;
    let mut i: i32 = 0;
    'outer: while i < n {
        let mut j: i32 = 0;
        while j < 3 {
            if j == 1 { break 'outer; }
            s = s + 1;
            j = j + 1;
        }
        i = i + 1;
    }
    return s + lbl_ref(n - 1);
}

// (4) 两层嵌套用户环 + 内层 return: 包装环的 break 必须穿透两层用户环
#[opt(inline_loop(recursive = 2))]
fn deep(n: i32) -> i32 {
    if n <= 0 { return 0; }
    let mut s: i32 = 0;
    let mut a: i32 = 0;
    while a < 3 {
        let mut b: i32 = 0;
        while b < 3 {
            if b == 1 { return s + 5; }
            s = s + a * 10 + b;
            b = b + 1;
        }
        s = s + deep(n - 1);
        a = a + 1;
    }
    return s;
}
fn deep_ref(n: i32) -> i32 {
    if n <= 0 { return 0; }
    let mut s: i32 = 0;
    let mut a: i32 = 0;
    while a < 3 {
        let mut b: i32 = 0;
        while b < 3 {
            if b == 1 { return s + 5; }
            s = s + a * 10 + b;
            b = b + 1;
        }
        s = s + deep_ref(n - 1);
        a = a + 1;
    }
    return s;
}

fn main() -> Int32 {
    let mut k: i32 = 0;
    let mut total: i32 = 0;
    while k <= 5 {
        let a1: i32 = brk(k);
        let b1: i32 = brk_ref(k);
        let a2: i32 = cont(k);
        let b2: i32 = cont_ref(k);
        let a3: i32 = lbl(k);
        let b3: i32 = lbl_ref(k);
        let a4: i32 = deep(k);
        let b4: i32 = deep_ref(k);
        if a1 != b1 || a2 != b2 || a3 != b3 || a4 != b4 {
            println!("MISMATCH at {}: {} {} {} {} vs {} {} {} {}",
                     k, a1, a2, a3, a4, b1, b2, b3, b4);
            return 1;
        }
        total = total + a1 + a2 + a3 + a4;
        k = k + 1;
    }
    println!("{}", total);
    println!("all match");
    return 0;
}
