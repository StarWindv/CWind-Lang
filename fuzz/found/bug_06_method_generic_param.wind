// SA false positive: method-level generic parameters are reported as
// unknown types when trait/impl/extra signatures are checked.
// Expected: no errors.  Reported: unknown type 'T' (one per declaration).

struct S {
}

extra S {
    fn id<T>(self, v: T) -> T {
        return v;
    }
}

trait Tr {
    fn pick<T>(self, v: T) -> T;
}

impl Tr for S {
    fn pick<T>(self, v: T) -> T {
        return v;
    }
}

fn f() -> Int {
    let s: S = S { };
    return s.id(1);
}
