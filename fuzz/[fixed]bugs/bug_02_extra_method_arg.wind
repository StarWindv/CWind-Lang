// SA false positive: generic extra method parameter type is not substituted.
// Expected: no errors.  Reported: argument 1 of 'set' must be T, got String.

struct Box<T> {
    pub x: T,
}

extra<T> Box<T> {
    fn set(self, v: T) -> None {
    }
}

fn f() -> None {
    let b: Box<String> = Box<String> { "a" };
    b.set("x");
}
