enum Option<T> {
    None,
    Some(T)
}

fn panic(msg: String) -> ! {
    print("panic: {}".format(msg));
    exit(1);
}

fn unwrap_failed() -> ! {
    panic("Called `Option::unwrap()` on a `None` value");
}

extra<T> Option<T> {
    pub fn unwrap(self) -> T {
        return match (self) {
            Option::Some(val) => val,
            _ => unwrap_failed(),
        };
    }
}

struct Node<T> {
    k: UInt,
    v: T,
}

struct MaxHeap<T> {
    max_heap: Vector<Option<Node<T>>>,
    capacity: UInt,
    size: UInt,
}

extra<T> MaxHeap<T> {
    fn new(capacity: UInt) -> Self {
        let i: UInt = 0;
        let max_heap: Vector<Option<Node<T>>> = Vector::new();
        while (i <= capacity) {
            max_heap.push_back(Option::None);
            i += 1;
        }
        return MaxHeap<T> { max_heap, capacity, 0 };
    }

    fn insert(self, k: UInt, v: T) {
        if (self.size >= self.capacity) {
            return;
        }
        self.size += 1;
        self.max_heap[self.size] = Option::Some(Node<T> { k, v });
        Self::shift_up(self.size);
    }

    fn shift_up(self, i: UInt) {
        while (i > 1 && self.max_heap[i].unwrap().k > self.max_heap[i / 2].unwrap().k) {
            Self::swap(i, i / 2);
            i /= 2;
        }
    }

    fn pop(self) -> Option<Node<T>> {
        if (self.size == 0) {
            return Option::None;
        }
        let top_node: Node<T> = self.max_heap[1].unwrap();
        self.max_heap[1] = self.max_heap[self.size];
        self.size -= 1;
        Self::shift_down(1);
        return Option::Some(top_node);
    }

    fn shift_down(self, i: UInt) {
        while (i * 2 <= self.size) {
            let j: UInt = i * 2;
            if (j + 1 <= self.size && self.max_heap[j + 1].unwrap().k > self.max_heap[j].unwrap().k) {
                j += 1;
            }
            if (self.max_heap[i].unwrap().k > self.max_heap[j].unwrap().k) {
                break;
            }
            Self::swap(i, j);
            i = j;
        }
    }

    fn swap(self, i: UInt, j: UInt) {
        let this_node: Node<T> = self.max_heap[i].unwrap();
        self.max_heap[i] = self.max_heap[j];
        self.max_heap[j] = Option::Some(this_node);
    }
}

fn main() -> Int {
    /* && 短路: 右操作数 (panic) 不得在左值为假时求值 */
    if (false && panic("must not run")) {
        print(1);
    } else {
        print(0);
    }

    let heap: MaxHeap<String> = MaxHeap::new(10);
    heap.insert(5, "five".to_string());
    heap.insert(3, "three".to_string());
    heap.insert(8, "eight".to_string());
    heap.insert(1, "one".to_string());
    heap.insert(9, "nine".to_string());
    heap.insert(7, "seven".to_string());
    let n1: Option<Node<String>> = heap.pop();
    match (n1) {
        Option::Some(n) => print("k={}, v={}".format(n.k, n.v)),
        Option::None => print("empty"),
    }
    let n2: Option<Node<String>> = heap.pop();
    match (n2) {
        Option::Some(n) => print("k={}, v={}".format(n.k, n.v)),
        Option::None => print("empty"),
    }
    return 0;
}
